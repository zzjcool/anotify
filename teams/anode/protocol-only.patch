index 0000000..c6d9db5
--- /dev/null
+++ b/internal/protocol/env_test.go
@@ -0,0 +1,136 @@
+package protocol
+
+import (
+	"strings"
+	"testing"
+)
+
+// TestEnvContractVariables 钉死四个 ANOTIFY_ 契约变量的字面值（capability.md §4.0）。
+//
+// 这些名字是协议：能力脚本、节点注入、文档三方必须逐字一致；改一个字就是
+// 「脚本读不到端点」。所以连值一起快照，不接受「反正 Go 常量两边都用」。
+func TestEnvContractVariables(t *testing.T) {
+	if EnvEmitEndpoint != "ANOTIFY_EMIT_ENDPOINT" {
+		t.Fatalf("EnvEmitEndpoint = %q", EnvEmitEndpoint)
+	}
+	if EnvTaskToken != "ANOTIFY_TASK_TOKEN" {
+		t.Fatalf("EnvTaskToken = %q", EnvTaskToken)
+	}
+	if EnvTaskID != "ANOTIFY_TASK_ID" {
+		t.Fatalf("EnvTaskID = %q", EnvTaskID)
+	}
+	if EnvParamPrefix != "ANOTIFY_PARAM_" {
+		t.Fatalf("EnvParamPrefix = %q", EnvParamPrefix)
+	}
+	// 全部以 ANOTIFY_ 开头；参数变量名必须真的挂在这个前缀上。
+	for _, name := range []string{EnvEmitEndpoint, EnvTaskToken, EnvTaskID, EnvParamPrefix} {
+		if !strings.HasPrefix(name, "ANOTIFY_") {
+			t.Fatalf("%q 不是 ANOTIFY_ 契约变量", name)
+		}
+	}
+	if got := ParamEnvName("x"); !strings.HasPrefix(got, EnvParamPrefix) {
+		t.Fatalf("ParamEnvName 没用 EnvParamPrefix：%q", got)
+	}
+}
+
+// TestParamEnvNameUppercase 大写规则：a-z 抬成 A-Z；已经是 A-Z 的原样保留。
+func TestParamEnvNameUppercase(t *testing.T) {
+	cases := map[string]string{
+		"sha":  "ANOTIFY_PARAM_SHA",
+		"SHA":  "ANOTIFY_PARAM_SHA",
+		"Sha":  "ANOTIFY_PARAM_SHA",
+		"repo": "ANOTIFY_PARAM_REPO",
+	}
+	for in, want := range cases {
+		if got := ParamEnvName(in); got != want {
+			t.Fatalf("ParamEnvName(%q) = %q，期望 %q", in, got, want)
+		}
+	}
+}
+
+// TestParamEnvNameDigits 数字原样保留，且不插任何分隔。
+func TestParamEnvNameDigits(t *testing.T) {
+	cases := map[string]string{
+		"sha256": "ANOTIFY_PARAM_SHA256",
+		"v2":     "ANOTIFY_PARAM_V2",
+		"3d":     "ANOTIFY_PARAM_3D",
+		"a1b2":   "ANOTIFY_PARAM_A1B2",
+	}
+	for in, want := range cases {
+		if got := ParamEnvName(in); got != want {
+			t.Fatalf("ParamEnvName(%q) = %q，期望 %q", in, got, want)
+		}
+	}
+}
+
+// TestParamEnvNameSymbols 符号规则：非 [A-Z0-9] 的字符替换成一个 '_'。
+func TestParamEnvNameSymbols(t *testing.T) {
+	cases := map[string]string{
+		"repo-url": "ANOTIFY_PARAM_REPO_URL",
+		"a.b c":    "ANOTIFY_PARAM_A_B_C",
+		"a/b":      "ANOTIFY_PARAM_A_B",
+		"x--y":     "ANOTIFY_PARAM_X__Y",
+		"_lead":    "ANOTIFY_PARAM__LEAD",
+		"":         "ANOTIFY_PARAM_",
+		// 非 ASCII 逐个 rune 换一个 '_'（多字节 rune 不变成多个下划线）。
+		"参数":    "ANOTIFY_PARAM___",
+		"naïve": "ANOTIFY_PARAM_NA_VE",
+	}
+	for in, want := range cases {
+		if got := ParamEnvName(in); got != want {
+			t.Fatalf("ParamEnvName(%q) = %q，期望 %q", in, got, want)
+		}
+	}
+}
+
+// TestParamEnvNameNoCamelBoundary 不插 camel 大小写边界：
+// repoUrl → REPOURL（不是 REPO_URL），workDirPath → WORKDIRPATH。
+//
+// 这条与 artifact 的私有实现逐字一致（artifact_test.go 的 TestParamEnvName
+// 有同样的样例）：两处必须同一行为，否则「写入期算的 env 名」和「运行期注入的
+// env 名」会分叉，脚本读不到参数。
+func TestParamEnvNameNoCamelBoundary(t *testing.T) {
+	cases := map[string]string{
+		"repoUrl":     "ANOTIFY_PARAM_REPOURL",
+		"workDirPath": "ANOTIFY_PARAM_WORKDIRPATH",
+	}
+	for in, want := range cases {
+		if got := ParamEnvName(in); got != want {
+			t.Fatalf("ParamEnvName(%q) = %q，期望 %q（不插 camel 边界）", in, got, want)
+		}
+	}
+	// 反证：带符号的形式才会出现下划线，两者不能混为一谈。
+	if ParamEnvName("repoUrl") == ParamEnvName("repo-url") {
+		t.Fatal("repoUrl 与 repo-url 归一后不该相同（不插 camel 边界）")
+	}
+}
+
+// TestParamEnvNameCollisions 归一撞名是**预期行为**：函数不报错、不消歧，
+// 由 artifact 在写入期用同一个函数检测并拒绝（param_env_collision）。
+//
+// 共享函数只负责规则一致；「谁覆盖谁」这种隐式行为不允许进入运行期。
+func TestParamEnvNameCollisions(t *testing.T) {
+	groups := [][]string{
+		{"sha", "SHA", "Sha"},
+		{"repo-url", "repo.url", "repo_url", "repo url", "REPO-URL"},
+		{"a-b", "a_b", "a b", "a.b"},
+	}
+	for _, group := range groups {
+		want := ParamEnvName(group[0])
+		for _, name := range group[1:] {
+			if got := ParamEnvName(name); got != want {
+				t.Fatalf("%q 与 %q 应当归一撞名：%q != %q", group[0], name, want, got)
+			}
+		}
+	}
+	// 不撞的名字不能被误并。
+	for _, pair := range [][2]string{
+		{"sha", "sha1"},
+		{"repo-url", "repoUrl"},
+		{"a", "A1"},
+	} {
+		if ParamEnvName(pair[0]) == ParamEnvName(pair[1]) {
+			t.Fatalf("%q 与 %q 不该撞名", pair[0], pair[1])
+		}
+	}
+}
diff --git a/internal/protocol/hash.go b/internal/protocol/hash.go
new file mode 100644
index 0000000..1cc6403
--- /dev/null
+++ b/internal/protocol/hash.go
@@ -0,0 +1,86 @@
+package protocol
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+)
+
+// MachineConfigHash 是机器级配置（本机 ⊕ 节点默认值）的内容哈希。
+//
+// 它只回答一个问题：「两台机器/两个时刻的**生效机器配置**是不是同一份」。
+// 因此输入只有两样东西：
+//
+//   - vars：机器级生效变量（local > node 合并结果）；
+//   - limits：机器级生效并发预算（local > node 逐叶合并结果，缺省 total=1）。
+//
+// 明确**不包含** revision（版本号变化不代表内容变化）、namespace 默认值
+// （ns 级、随任务内存下发，不进 applied）、token、宿主凭证、envPassthrough
+// （完整名单只在本机，不上报）。两侧（中枢算期望值 / 节点算 appliedHash）
+// 只调用这一份实现，禁止第二份 hash 算法。
+//
+// 归一化后取 canonical JSON（`vars` / `limits` 两个键，map 键由
+// encoding/json 排序），SHA-256 输出 `sha256:<64 hex>`（与 artifact 的 digest
+// 同前缀）。空 map 与 nil 一律写成 `{}`；`limits.total` 未设置（0）归一为
+// 缺省 1；`limits.perCapability` 同理缺省 `{}`。
+//
+// 负的 total 不是「未设置」，无法归一成缺省值：返回 error（正常配置在
+// 写入期就被拒，这里只是不静默吞掉非法输入）。
+func MachineConfigHash(vars map[string]string, limits Limits) (string, error) {
+	canonical, err := machineConfigCanonicalJSON(vars, limits)
+	if err != nil {
+		return "", err
+	}
+	sum := sha256.Sum256(canonical)
+	return "sha256:" + hex.EncodeToString(sum[:]), nil
+}
+
+// machineConfigDoc 是 hash 的 canonical 文档形状。
+//
+// 字段顺序即字节顺序：`vars` 在前、`limits` 在后；两级 map 的键都由
+// encoding/json 按字节序排序，所以同一内容永远得到同一串字节。
+type machineConfigDoc struct {
+	Vars   map[string]string   `json:"vars"`
+	Limits machineConfigLimits `json:"limits"`
+}
+
+// machineConfigLimits 是 canonical 文档里的 limits。
+//
+// 两个字段都**不加 omitempty**：空 perCapability 必须写成 `{}`（而不是省略或
+// null），否则「没配 perCapability」和「配了个空的」会在 hash 上分叉。
+type machineConfigLimits struct {
+	Total         int            `json:"total"`
+	PerCapability map[string]int `json:"perCapability"`
+}
+
+// machineConfigCanonicalJSON 产出 hash 的输入字节（归一 + canonical 排序）。
+func machineConfigCanonicalJSON(vars map[string]string, limits Limits) ([]byte, error) {
+	total := limits.Total
+	if total == 0 {
+		total = DefaultLimitsTotal
+	}
+	if total < 0 {
+		return nil, fmt.Errorf("protocol: MachineConfigHash: limits.total 不能为负：%d", total)
+	}
+	// 复制一份：不把调用方的 nil / map 别名带进编码，也避免后续被并发改。
+	normVars := make(map[string]string, len(vars))
+	for name, value := range vars {
+		normVars[name] = value
+	}
+	perCapability := make(map[string]int, len(limits.PerCapability))
+	for name, value := range limits.PerCapability {
+		perCapability[name] = value
+	}
+	raw, err := json.Marshal(machineConfigDoc{
+		Vars: normVars,
+		Limits: machineConfigLimits{
+			Total:         total,
+			PerCapability: perCapability,
+		},
+	})
+	if err != nil {
+		return nil, fmt.Errorf("protocol: MachineConfigHash: 编码 canonical JSON: %w", err)
+	}
+	return raw, nil
+}
diff --git a/internal/protocol/hash_test.go b/internal/protocol/hash_test.go
new file mode 100644
index 0000000..6a466b2
--- /dev/null
+++ b/internal/protocol/hash_test.go
@@ -0,0 +1,221 @@
+package protocol
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"sort"
+	"strings"
+	"testing"
+)
+
+// goldenMachineHash 独立于实现算一遍期望值：喂**手写的** canonical JSON，
+// 避免「实现自己算一遍再和自己比」的假绿。
+func goldenMachineHash(canonical string) string {
+	sum := sha256.Sum256([]byte(canonical))
+	return "sha256:" + hex.EncodeToString(sum[:])
+}
+
+// TestMachineConfigHashGolden 钉死 canonical 文档形状与 golden hash。
+//
+// canonical JSON 只有两个顶层键 `vars` / `limits`；两级 map 的键按字节序排序；
+// 空 map/nil 写成 `{}` 而不是 null；total 未设置归一成缺省 1。
+func TestMachineConfigHashGolden(t *testing.T) {
+	cases := []struct {
+		name      string
+		vars      map[string]string
+		limits    Limits
+		canonical string
+	}{
+		{
+			name:      "nil vars + 零值 limits 归一",
+			vars:      nil,
+			limits:    Limits{},
+			canonical: `{"vars":{},"limits":{"total":1,"perCapability":{}}}`,
+		},
+		{
+			name:      "空 map 与 nil 等价",
+			vars:      map[string]string{},
+			limits:    Limits{Total: 1, PerCapability: map[string]int{}},
+			canonical: `{"vars":{},"limits":{"total":1,"perCapability":{}}}`,
+		},
+		{
+			name: "vars 与 perCapability 键排序",
+			vars: map[string]string{"B": "2", "A": "1"},
+			limits: Limits{
+				Total:         8,
+				PerCapability: map[string]int{"review": 2, "*": 1},
+			},
+			canonical: `{"vars":{"A":"1","B":"2"},"limits":{"total":8,"perCapability":{"*":1,"review":2}}}`,
+		},
+		{
+			name:      "HTML 字符按 encoding/json 默认转义（两侧同字节）",
+			vars:      map[string]string{"A": "a<b&c"},
+			limits:    Limits{Total: 2},
+			canonical: `{"vars":{"A":"a\u003cb\u0026c"},"limits":{"total":2,"perCapability":{}}}`,
+		},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := MachineConfigHash(tc.vars, tc.limits)
+			if err != nil {
+				t.Fatalf("MachineConfigHash: %v", err)
+			}
+			want := goldenMachineHash(tc.canonical)
+			if got != want {
+				t.Fatalf("hash = %s，期望 %s（canonical %s）", got, want, tc.canonical)
+			}
+			// 同时钉 canonical 字节本身：hash 对了但形状漂了同样是断约。
+			raw, err := machineConfigCanonicalJSON(tc.vars, tc.limits)
+			if err != nil {
+				t.Fatalf("machineConfigCanonicalJSON: %v", err)
+			}
+			if string(raw) != tc.canonical {
+				t.Fatalf("canonical JSON = %s，期望 %s", raw, tc.canonical)
+			}
+		})
+	}
+}
+
+// TestMachineConfigHashDefaults 显式缺省值 == 未设置（total:0 归一成 1）。
+func TestMachineConfigHashDefaults(t *testing.T) {
+	unset, err := MachineConfigHash(nil, Limits{})
+	if err != nil {
+		t.Fatalf("MachineConfigHash: %v", err)
+	}
+	explicit, err := MachineConfigHash(nil, Limits{Total: DefaultLimitsTotal})
+	if err != nil {
+		t.Fatalf("MachineConfigHash: %v", err)
+	}
+	if unset != explicit {
+		t.Fatalf("total 未设置与显式缺省值必须同 hash：%s != %s", unset, explicit)
+	}
+	if DefaultLimitsTotal != 1 {
+		t.Fatalf("DefaultLimitsTotal = %d，期望 1", DefaultLimitsTotal)
+	}
+}
+
+// TestMachineConfigHashCanonicalKeys 只含 vars/limits 两个顶层键，绝不夹带
+// revision / ns 默认 / token / 凭证 / envPassthrough（那些不进机器配置内容）。
+func TestMachineConfigHashCanonicalKeys(t *testing.T) {
+	raw, err := machineConfigCanonicalJSON(
+		map[string]string{"SOURCE_ROOT": "/srv/src"},
+		Limits{Total: 4, PerCapability: map[string]int{"review": 2}},
+	)
+	if err != nil {
+		t.Fatalf("machineConfigCanonicalJSON: %v", err)
+	}
+	var top map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &top); err != nil {
+		t.Fatalf("canonical JSON 不可解析：%v", err)
+	}
+	keys := make([]string, 0, len(top))
+	for k := range top {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	if len(keys) != 2 || keys[0] != "limits" || keys[1] != "vars" {
+		t.Fatalf("canonical 顶层键 = %v，期望只有 [limits vars]", keys)
+	}
+	var limits map[string]json.RawMessage
+	if err := json.Unmarshal(top["limits"], &limits); err != nil {
+		t.Fatalf("limits 不可解析：%v", err)
+	}
+	limitKeys := make([]string, 0, len(limits))
+	for k := range limits {
+		limitKeys = append(limitKeys, k)
+	}
+	sort.Strings(limitKeys)
+	if len(limitKeys) != 2 || limitKeys[0] != "perCapability" || limitKeys[1] != "total" {
+		t.Fatalf("limits 键 = %v，期望 [perCapability total]", limitKeys)
+	}
+	for _, banned := range []string{"revision", "namespace", "secret", "token", "envPassthrough", "credentials"} {
+		if strings.Contains(string(raw), banned) {
+			t.Fatalf("canonical JSON 夹带了 %q：%s", banned, raw)
+		}
+	}
+}
+
+// TestMachineConfigHashOrderInsensitive map 迭代顺序不得影响结果。
+func TestMachineConfigHashOrderInsensitive(t *testing.T) {
+	vars := map[string]string{"Z": "26", "A": "1", "M": "13", "B": "2"}
+	limits := Limits{Total: 8, PerCapability: map[string]int{"review": 2, "fix": 1, "*": 3}}
+	want, err := MachineConfigHash(vars, Limits{Total: 8, PerCapability: map[string]int{"review": 2, "fix": 1, "*": 3}})
+	if err != nil {
+		t.Fatalf("MachineConfigHash: %v", err)
+	}
+	for i := 0; i < 32; i++ {
+		// 每次重建 map（Go 的 map 迭代顺序随机，重建后编码路径必须仍稳定）。
+		v := map[string]string{}
+		for k, val := range vars {
+			v[k] = val
+		}
+		l := Limits{Total: limits.Total, PerCapability: map[string]int{}}
+		for k, val := range limits.PerCapability {
+			l.PerCapability[k] = val
+		}
+		got, err := MachineConfigHash(v, l)
+		if err != nil {
+			t.Fatalf("MachineConfigHash: %v", err)
+		}
+		if got != want {
+			t.Fatalf("第 %d 次 hash 漂了：%s != %s", i, got, want)
+		}
+	}
+}
+
+// TestMachineConfigHashContentSensitive 内容变了 hash 必须变（否则 drift 判不出来）。
+func TestMachineConfigHashContentSensitive(t *testing.T) {
+	base, err := MachineConfigHash(map[string]string{"A": "1"}, Limits{Total: 4})
+	if err != nil {
+		t.Fatalf("MachineConfigHash: %v", err)
+	}
+	variants := []struct {
+		name   string
+		vars   map[string]string
+		limits Limits
+	}{
+		{"变量值变", map[string]string{"A": "2"}, Limits{Total: 4}},
+		{"变量名变", map[string]string{"B": "1"}, Limits{Total: 4}},
+		{"多一个变量", map[string]string{"A": "1", "B": "1"}, Limits{Total: 4}},
+		{"total 变", map[string]string{"A": "1"}, Limits{Total: 5}},
+		{"perCapability 变", map[string]string{"A": "1"}, Limits{Total: 4, PerCapability: map[string]int{"review": 2}}},
+	}
+	for _, v := range variants {
+		got, err := MachineConfigHash(v.vars, v.limits)
+		if err != nil {
+			t.Fatalf("%s: MachineConfigHash: %v", v.name, err)
+		}
+		if got == base {
+			t.Fatalf("%s 之后 hash 没变（%s）", v.name, got)
+		}
+	}
+}
+
+// TestMachineConfigHashNegativeTotal 负 total 不是「未设置」，不静默归一。
+func TestMachineConfigHashNegativeTotal(t *testing.T) {
+	if _, err := MachineConfigHash(nil, Limits{Total: -1}); err == nil {
+		t.Fatal("负 total 必须报错")
+	}
+}
+
+// TestMachineConfigHashFormat 输出形如 sha256:<64 hex>（与 artifact digest 同前缀）。
+func TestMachineConfigHashFormat(t *testing.T) {
+	got, err := MachineConfigHash(map[string]string{"A": "1"}, Limits{Total: 2})
+	if err != nil {
+		t.Fatalf("MachineConfigHash: %v", err)
+	}
+	if !strings.HasPrefix(got, "sha256:") {
+		t.Fatalf("hash 前缀不对：%s", got)
+	}
+	hexPart := strings.TrimPrefix(got, "sha256:")
+	if len(hexPart) != 64 {
+		t.Fatalf("hash hex 长度 = %d，期望 64（%s）", len(hexPart), got)
+	}
+	if _, err := hex.DecodeString(hexPart); err != nil {
+		t.Fatalf("hash 不是 hex：%v", err)
+	}
+	if len(got) != len("sha256:")+64 {
+		t.Fatalf("hash 总长 = %d", len(got))
+	}
+}
