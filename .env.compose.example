# .env.compose.example —— docker-compose 部署环境模板
#
# 用法：cp .env.compose.example .env 然后填入真实值
# docker compose 会自动加载同目录下的 .env（已在 .gitignore，不入库）
#
# VAPID 密钥用 `make keys` 生成（在仓库根目录跑）

# ---------- VAPID（Web Push，必填）----------
ANOTIFY_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
ANOTIFY_VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE
ANOTIFY_VAPID_SUBJECT=mailto:you@example.com

# ---------- WebAuthn RP（必填，= 实际访问域名）----------
# RP_ID 是域名本身（不含协议/端口）；RP_ORIGIN 含协议
# 例：域名 notify.example.com
#   ANOTIFY_RP_ID=notify.example.com
#   ANOTIFY_RP_ORIGIN=https://notify.example.com
ANOTIFY_RP_ID=notify.example.com
ANOTIFY_RP_ORIGIN=https://notify.example.com
ANOTIFY_RP_DISPLAY=Anotify

# ---------- 端口（宿主机侧，容器内固定 8080）----------
ANOTIFY_PORT=8080
