# .env.example —— 本地开发环境模板
#
# 用法：cp .env.example .env.local  然后填入真实 VAPID 密钥
# .env.local 在 .gitignore，不入库。
# scripts/dev.sh 会自动加载 .env.local。

# ---------- 服务 ----------
ANOTIFY_ADDR=:8080
ANOTIFY_DB=./anotify.db
# 开发模式用 web/ 源文件（不指纹），由 scripts/dev.sh 设默认
ANOTIFY_STATIC=./web

# ---------- WebAuthn RP（开发域名）----------
# 配合 cloudflared tunnel（固定 dev.openaaas.org → localhost:8080）
# Passkey 的 RP_ID 必须是域名（不含协议/端口），RP_ORIGIN 含协议
ANOTIFY_RP_ID=dev.openaaas.org
ANOTIFY_RP_ORIGIN=https://dev.openaaas.org
ANOTIFY_RP_DISPLAY=Anotify

# ---------- VAPID（Web Push）----------
# 用 `make keys` 生成你自己的密钥对，填到 .env.local
# 不要用 example 里的占位值——推送会失败
ANOTIFY_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
ANOTIFY_VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE
ANOTIFY_VAPID_SUBJECT=mailto:you@example.com
