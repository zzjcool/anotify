# .env.dev.example —— 本地开发环境模板
#
#   cp .env.dev.example .env.dev
#   make dev-env      # 自动填入真实 VAPID 密钥
#
# .env.dev 已在 .gitignore，不入库。
#
# VAPID 密钥是本机生成的，换机器/重置后需要重新生成（旧订阅会失效，本地开发无所谓）。

# ---------- VAPID（Web Push，必填）----------
ANOTIFY_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_HERE
ANOTIFY_VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY_HERE
ANOTIFY_VAPID_SUBJECT=mailto:dev@openaaas.org

# ---------- WebAuthn RP（必须 = 实际访问域名，否则 Passkey 注册/登录失败）----------
# 固定给隧道域名：这样通过 https://anotify-dev.openaaas.org 访问时 Passkey 可用。
# 只用 localhost:8080 时，浏览器认为 RP_ID 不匹配 → 用 devseed 的自动登录页绕过。
ANOTIFY_RP_ID=anotify-dev.openaaas.org
ANOTIFY_RP_ORIGIN=https://anotify-dev.openaaas.org
ANOTIFY_RP_DISPLAY=Anotify Dev

# ---------- 端口与日志 ----------
ANOTIFY_DEV_PORT=8080
ANOTIFY_DEV_BIND=127.0.0.1
ANOTIFY_LOG_LEVEL=debug

# ---------- Cloudflare 命名隧道（想要固定域名才需要填）----------
# 留空 = 不启用（make dev-up 不会起 tunnel）。
# 填法见 docs/dev-docker.md：
#   Cloudflare Dashboard → Zero Trust → Networks → Tunnels → Create
#   然后把它给出的 token 粘贴到这里，并把 Public hostname 配成
#       anotify-dev.openaaas.org  →  http://anotify:8080
CLOUDFLARE_TUNNEL_TOKEN=
