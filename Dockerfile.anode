FROM golang:1.25-alpine AS build
WORKDIR /src
# GOPROXY=direct needs git in the builder (not in the runtime image).
RUN apk add --no-cache git ca-certificates
COPY go.mod go.sum ./
COPY internal/protocol ./internal/protocol
COPY internal/artifact ./internal/artifact
COPY cmd/anode ./cmd/anode
ARG VERSION=dev
ARG COMMIT=unknown
RUN CGO_ENABLED=0 GOPROXY=direct GOSUMDB=sum.golang.org GOTOOLCHAIN=auto go build -trimpath -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" -o /anode ./cmd/anode

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /anode /usr/local/bin/anode
# No host environment import. Config whitelist and explicit docker -e are both required.
VOLUME ["/etc/anode", "/var/lib/anode"]
ENTRYPOINT ["/usr/local/bin/anode"]
CMD ["serve", "--config", "/etc/anode/anode.yaml", "--data", "/var/lib/anode"]
