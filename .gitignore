subscriptions.json
*.db
*.db-wal
*.db-shm
.env.local
.env
/.env.dev
/.dev-tunnel/

# === 依赖 ===
node_modules/

# === 构建产物 ===
anotify
/anode
/anotify-agent
/devseed
/sitegen
/server
/agent
/fe-preview
dist/
web/dist/
internal/server/dist/
.e2e-bin/
