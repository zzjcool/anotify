/.dev-anode/
# Python 脚本的字节码缓存（check_*.py）
__pycache__/

# === 前端生成产物（源在 web-src/，sitegen 生成）===
# 顶层 *.html、i18n js、各语言子目录全部由 sitegen 从 web-src 生成，不入库
web/*.html
web/en/
web/es/
web/ja/
web/i18n.*.js

# === 编排/调试临时产物（开发过程用，不入库）===
# pi-async 的运行时产物（任务输出 / 状态）；会话里随时生成，别提交
.pi/async/
.pi-orchestrator/worktrees/
.pi-orchestrator/tasks/
.pi-orchestrator/out/
.pi-subagents/
.pi/web-verify-shots/
.pi/agent-memory/
*.log

# === 编辑器/系统 ===
.DS_Store
*.swp
.idea/
.vscode/

# === legion 编排运行时（契约/报告等，不入库）===
.pi-legion/

# worktree 里软链到主 checkout 的 node_modules（不提交、不复制）
node_modules

# design 目录下的截图产物（7.8MB PNG，只是视觉对照，不入库）
design/silk-shots/
